{
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "functions",
    "dist",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@expo/vector-icons": ["./node_modules/expo/node_modules/@expo/vector-icons"],
      "@expo/vector-icons/*": ["./node_modules/expo/node_modules/@expo/vector-icons/*"]
    }
  }
}
