{
  "expo": {
    "name": "yOdin",
    "slug": "yodin",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "app.yodin",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "7",
      "bundleIdentifier": "app.yodin",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.yodin",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C35DE"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow yOdin to access your photos to attach them to discussions and posts.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow yOdin to access your photos to attach them to discussions and posts.",
          "cameraPermission": "Allow yOdin to use your camera to take a photo for your posts, discussions and profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-font",
      "@react-native-community/datetimepicker",
      "./plugins/withTransparentNavigationBar",
      "./plugins/withLegacyStoragePermission",
      "./plugins/withReleaseSigning",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#6C35DE"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "667ca167-3af3-415c-a811-758ca5aea1a4"
      }
    },
    "owner": "onlymaxons-team"
  }
}
