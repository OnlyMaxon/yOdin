rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — owner-scoped by path.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Post media. New uploads are owner-scoped: posts/{uid}/{postId}/{file},
    // so only the author (uid == the {owner} segment) may write — nobody else
    // can overwrite or plant files in someone's post. The legacy two-segment
    // path posts/{postId}/{file} stays readable so pre-existing posts' images
    // keep loading, but takes no new writes.
    match /posts/{owner} {
      match /{postId}/{fileName} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == owner
          && (
            (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
            || (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
          );
        // The author cleans up their own media; a moderator may remove reported media.
        allow delete: if request.auth != null
          && (request.auth.uid == owner || request.auth.token.moderator == true);
      }
      // Legacy path (pre owner-scoping) — read only, plus best-effort cleanup.
      match /{fileName} {
        allow read: if true;
        allow delete: if request.auth != null;
      }
    }

    // Discussion media — same owner-scoped scheme as posts.
    match /discussions/{owner} {
      match /{discussionId}/{fileName} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == owner
          && (
            (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
            || (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
          );
        allow delete: if request.auth != null
          && (request.auth.uid == owner || request.auth.token.moderator == true);
      }
      match /{fileName} {
        allow read: if true;
        allow delete: if request.auth != null;
      }
    }
  }
}
